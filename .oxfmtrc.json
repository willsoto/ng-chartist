{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": true,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 80,
  "sortPackageJson": true,
  "sortImports": true,
  "ignorePatterns": [
    "node_modules",
    "CHANGELOG.md",
    "dist",
    "coverage",
    "pnpm-lock.yaml",
    ".angular"
  ]
}
